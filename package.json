{
  "name": "api-testing-pactumjs-mocha-javascript",
  "version": "1.0.0",
  "description": "API Testing using PactumJS Mocha and JavaScript",
  "main": "index.js",
  "scripts": {
    "test": "mocha ./test-api/*.js --reporter spec --reporter mochawesome --timeout 5000",
    "lt": "cross-env CONFIG_FILE=lt ./node_modules/.bin/mocha ./test-api/*.js"
  },
  "keywords": [
    "PactumJS",
    "Mocha",
    "JavaScript",
    "API Testing",
    "API Automation"
  ],
  "author": "Code with MMAK",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "pactum": "^3.9.0"
  }
}