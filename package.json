{
  "name": "api-testing-pactumjs-mocha-javascript",
  "version": "1.0.0",
  "description": "API Testing using PactumJS Mocha and JavaScript",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:petstore",
    "test:runner:petstore": "mocha \"tests/api/specs/pet/**/*.js\" --require ./tests/api/support/setup.js --reporter mocha-multi-reporters --reporter-options configFile=.mocha-reporters.json",
    "test:petstore": "cross-env ENV=petstore npm run test:runner:petstore",
    "test:petstore:auth": "cross-env ENV=petstore REQUIRE_API_KEY=true npm run test:runner:petstore",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test:ci": "npm run lint && npm run test:petstore && npm run test:petstore:auth"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "PactumJS",
    "Mocha",
    "JavaScript",
    "API Testing",
    "API Automation"
  ],
  "author": "Code with MMAK",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.0.0",
    "mocha": "^11.7.6",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.4",
    "pactum": "^3.9.1"
  }
}